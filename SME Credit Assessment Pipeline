   "source": [
    "# 2 Load Data & Train/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "d25c1ca4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Data\n",
    "raw = pd.read_csv(DATA_PATH)\n",
    "processed = preprocess(raw, is_training=True)\n",
    "y = processed.pop(TARGET)\n",
    "X = processed\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)\n",
    "\n",
    "num_feats = [c for c in X.columns if X[c].dtype in ['int64','float64']]\n",
    "cat_feats = [c for c in X.columns if X[c].dtype == 'object']"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "45d84e91",
   "metadata": {},
   "source": [
    "# 3 Imputation and Encoding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4e4ea832",
   "metadata": {},
   "outputs": [],
   "source": [
    "preprocessor = ColumnTransformer([\n",
    "    (\"num\", Pipeline([(\"impute\", SimpleImputer(strategy=\"median\")), (\"scale\", StandardScaler())]), num_feats),\n",
    "    (\"cat\", Pipeline([(\"impute\", SimpleImputer(strategy=\"most_frequent\")), \n",
    "                      (\"encode\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))]), cat_feats)\n",
    "], remainder=\"drop\")"
   ]
  },
